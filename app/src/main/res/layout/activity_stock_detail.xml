<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#121212"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1565C0"
        android:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ProgressBar
        android:id="@+id/progressDetail"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/tvDetailError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textColor="#D32F2F"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 报价卡片 -->
            <LinearLayout
                android:orientation="vertical"
                android:background="#1A1A1A"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvDetailPrice"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvDetailChange"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="4dp"
                        android:textSize="15sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <GridLayout
                    android:layout_marginTop="12dp"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView android:id="@+id/tvDetailOpen" android:layout_columnWeight="1"
                        android:textColor="#AAAAAA" android:textSize="13sp" android:padding="4dp"
                        android:layout_width="0dp" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvDetailHigh" android:layout_columnWeight="1"
                        android:textColor="#AAAAAA" android:textSize="13sp" android:padding="4dp"
                        android:layout_width="0dp" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvDetailLow" android:layout_columnWeight="1"
                        android:textColor="#AAAAAA" android:textSize="13sp" android:padding="4dp"
                        android:layout_width="0dp" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvDetailVolume" android:layout_columnWeight="1"
                        android:textColor="#AAAAAA" android:textSize="13sp" android:padding="4dp"
                        android:layout_width="0dp" android:layout_height="wrap_content" />
                </GridLayout>

                <TextView
                    android:id="@+id/tvDetailPrevClose"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- Tab 切换 -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/btnTabMinute"
                    android:text="分时"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/btnTabKline"
                    android:text="K线"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 图表区 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <com.example.astockscreener.MinuteChartView
                    android:id="@+id/minuteChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.example.astockscreener.KlineChartView
                    android:id="@+id/klineChart"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 资讯列表 -->
            <TextView
                android:text="相关资讯"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/newsContainer"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
